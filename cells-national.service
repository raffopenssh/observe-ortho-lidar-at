[Unit]
Description=srtm-lidar-at: rebuild the Austria-wide cells aggregate (cells_national.py)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/srtm-lidar
ExecStart=/usr/bin/python3 cells_national.py --build --quiet
Nice=15
IOSchedulingClass=idle
MemoryMax=2500M
TimeoutStartSec=2h
