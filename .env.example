# Copy to .env (git-ignored) or export in the service environment.
# Every variable is optional; empty = feature disabled / single-VM defaults.

# Ports and bind addresses
SRTM_APP_PORT=8000            # operator API + processor/director (app.py)
SRTM_APP_BIND=127.0.0.1       # keep loopback-only; mutating routes have no auth on loopback
SRTM_PUBLIC_PORT=8100         # read-only public API (public_api.py)
SRTM_PUBLIC_BIND=0.0.0.0
#SRTM_APP_URL=http://127.0.0.1:8000
#SRTM_SELF_URL=https://your-host.example.org     # used in share links only

# Data / secrets locations
#SRTM_DATA_DIR=/home/user/srtm-lidar/data
#SRTM_SECRETS_DIR=/home/user/.config/srtm-lidar  # zenodo_token, operator_token, copernicus_credentials.json
#SRTM_OUT_DIR=/home/user/srtm-lidar/out          # products when uploads are disabled

# Multi-VM (leave empty for single-VM mode)
#SRTM_PRIMARY_URL=https://director.example.org:8000
#SRTM_PEERS=https://worker1.example.org:8000,https://worker2.example.org:8000
#SRTM_PEER_ID=worker1                            # this instance's id in the roster (workers only)

# Operator token for mutating routes from non-loopback clients (X-Operator-Token)
#SRTM_OPERATOR_TOKEN=

# Zenodo (uploads disabled when empty → products written to SRTM_OUT_DIR)
#ZENODO_TOKEN=
#ZENODO_CACHE_DEPOSIT=19650075
#SRTM_DRY_RUN=1

# Copernicus Data Space (openEO) credentials file
#COPERNICUS_CREDENTIALS_FILE=/home/user/.config/srtm-lidar/copernicus_credentials.json

# Optional upstream services (disabled when empty)
#POWER_API_URL=
#UMFELD_URL=
#INVEKOS_API_URL=
#ZENODO_LOCK_URL=

# Feature flags
SRTM_BEV_VECTOR_CONTEXT=0     # in-RAM building footprints from public BEV vector tiles
PUBLIC_MAX_AREA_KM=5
SRTM_SHARE_CAP_MB=1024
#SRTM_EXTRA_ALLOWED_HOSTS=
