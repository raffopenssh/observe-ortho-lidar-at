[Unit]
Description=srtm-lidar-at: linear-noise runs in the tree apices (ne_linear.py --backfill; only KG files that changed)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/srtm-lidar
ExecStart=/usr/bin/python3 ne_linear.py --backfill --budget-s 3000 --quiet
# tree position fix: state ↔ auto-shift flags, a rejected flag switches the fix off (docs/tree-user.md → Position frames)
ExecStartPost=-/usr/bin/python3 ne_pos_fix.py --sync
Nice=19
CPUWeight=10
CPUQuota=70%
IOSchedulingClass=idle
MemoryMax=1500M
TimeoutStartSec=70min
