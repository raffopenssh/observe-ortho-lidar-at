# Builds / refreshes the per-bin NEX1 exports, the prebuilt NEXB v2 blocks and
# the national sample (cells_bins.py --prewarm) with a 50 min budget; the timer
# runs it hourly until every bin / block of Austria is stored and current.
[Unit]
Description=observe-ortho-lidar-at: build the per-bin cells exports, blocks and national sample
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/srtm-lidar-public
ExecStart=%h/srtm-lidar-public/.venv/bin/python3 cells_bins.py --prewarm --budget-s 3000 --jobs 2 --quiet
Nice=15
IOSchedulingClass=idle
MemoryMax=2500M
TimeoutStartSec=70min
